NODE_ENV=development
APP_HOST=127.0.0.1
APP_PORT=3004
APP_ALLOWED_ORIGINS=http://127.0.0.1:3001,http://localhost:3001
FIREBASE_PROJECT_ID=drawsy-ai-dev
APP_SCENE_SIZE_LIMIT_BYTES=20971520

R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=<bucket-name>
R2_REGION=auto
R2_KEY_PREFIX=workspace/
R2_ACCESS_KEY_ID=<access-key-id>
R2_SECRET_ACCESS_KEY=<secret-access-key>
WORKSPACE_ENCRYPTION_KEY=<base64-encoded-32-byte-key>

# Jira Cloud OAuth 2.0 (3LO). Configure all four values together.
ATLASSIAN_OAUTH_CLIENT_ID=
ATLASSIAN_OAUTH_CLIENT_SECRET=
ATLASSIAN_OAUTH_REDIRECT_URI=http://127.0.0.1:3004/v1/jira/oauth/callback
JIRA_OAUTH_SUCCESS_URL=http://localhost:3001/jira-oauth-complete.html
# Optional dedicated key and rotation settings; defaults to WORKSPACE_ENCRYPTION_KEY.
JIRA_ENCRYPTION_KEY=
JIRA_ENCRYPTION_KEY_VERSION=1
JIRA_ENCRYPTION_PREVIOUS_KEYS=
JIRA_OAUTH_STATE_TTL_SECONDS=600
JIRA_HTTP_TIMEOUT_MS=15000

# Connector OAuth. Configure each provider's three values together.
CONNECTORS_OAUTH_SUCCESS_URL=http://localhost:3001/connectors-oauth-complete.html
GOOGLE_WORKSPACE_OAUTH_CLIENT_ID=
GOOGLE_WORKSPACE_OAUTH_CLIENT_SECRET=
GOOGLE_WORKSPACE_OAUTH_REDIRECT_URI=http://127.0.0.1:3004/v1/connectors/google-workspace/oauth/callback
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=http://127.0.0.1:3004/v1/connectors/notion/oauth/callback
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_REDIRECT_URI=http://127.0.0.1:3004/v1/connectors/slack/oauth/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://127.0.0.1:3004/v1/connectors/github/oauth/callback
# Optional dedicated key and rotation settings; defaults to WORKSPACE_ENCRYPTION_KEY.
CONNECTOR_ENCRYPTION_KEY=
CONNECTOR_ENCRYPTION_KEY_VERSION=1
CONNECTOR_ENCRYPTION_PREVIOUS_KEYS=
CONNECTOR_OAUTH_STATE_TTL_SECONDS=600
CONNECTOR_HTTP_TIMEOUT_MS=15000
KANBAN_ENCRYPTION_KEY=<base64-encoded-32-byte-key>
KANBAN_ENCRYPTION_KEY_VERSION=1
# During rotation: comma-separated old-version:base64-key pairs.
KANBAN_ENCRYPTION_PREVIOUS_KEYS=
KANBAN_EMAIL_DIGEST_KEY=<base64-encoded-32-byte-key>
KANBAN_SSE_HEARTBEAT_MS=45000
KANBAN_EVENT_RETENTION_DAYS=30
KANBAN_OPERATION_RETENTION_DAYS=30
KANBAN_INVITES_PER_HOUR=20
KANBAN_RECENT_AUTH_SECONDS=300

# Local development outside Google Cloud:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
